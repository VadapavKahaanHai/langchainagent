# Gemini is the only model provider used by this project.
DEFAULT_PROVIDER=gemini
GOOGLE_API_KEY=
# Use a tool-calling model available to your account.
GEMINI_MODEL=gemini-3.8-flash

AGENT_TEMPERATURE=0.2
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=true
